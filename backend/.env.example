# ════════════════════════════════════════════════════════════════
# إعدادات نظام إدارة الكافيه
# Cafe Management System Configuration
# ════════════════════════════════════════════════════════════════
#
# انسخ هذا الملف إلى .env وعدّل القيم حسب السيرفر الخاص بك
# Copy this file to .env and modify values for your server
#
# ════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# Server Configuration (إعدادات السيرفر)
# ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────
# Database Configuration (إعدادات قاعدة البيانات)
# ─────────────────────────────────────────────────────────────────
# MySQL Server
DB_HOST=localhost
DB_PORT=3306

# Database Credentials (بيانات الدخول)
DB_USER=root
DB_PASSWORD=your_mysql_password

# Database Name (اسم قاعدة البيانات)
DB_NAME=cafe_management

# Optional: Socket path for local MySQL (Unix/Linux only)
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# ─────────────────────────────────────────────────────────────────
# JWT Configuration (إعدادات التوثيق)
# ─────────────────────────────────────────────────────────────────
# مهم جداً: غيّر هذه القيمة لقيمة عشوائية طويلة وآمنة
# IMPORTANT: Change this to a long random secure string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_abc123xyz789

# مدة صلاحية التوكن (7 أيام افتراضياً)
# Token expiry (default: 7 days)
JWT_EXPIRE=7d

# ─────────────────────────────────────────────────────────────────
# Upload Configuration (إعدادات رفع الملفات)
# ─────────────────────────────────────────────────────────────────
UPLOAD_PATH=./uploads

# ════════════════════════════════════════════════════════════════
# ملاحظات مهمة:
# ════════════════════════════════════════════════════════════════
#
# 1. تأكد من تغيير كلمة مرور MySQL (DB_PASSWORD)
# 2. تأكد من تغيير JWT_SECRET لقيمة آمنة
# 3. للإنتاج، غيّر NODE_ENV إلى production
#
# للإعداد السريع:
#   1. انسخ هذا الملف: cp .env.example .env
#   2. عدّل القيم في .env
#   3. شغّل: node deploy-setup.js
#   4. تحقق: node deploy-verify.js
#   5. شغّل السيرفر: npm start
#
# ════════════════════════════════════════════════════════════════
